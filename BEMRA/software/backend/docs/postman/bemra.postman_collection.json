          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"bms-001 registered\", () => pm.expect(pm.response.json().data.map(d => d.device_id)).to.include(\"bms-001\"));"
            ]
          }
        }
      ]
