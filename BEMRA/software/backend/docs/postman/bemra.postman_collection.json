        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}",
            "disabled": false
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}/telemetry?from=2026-10-09T00:00:00Z&to=2026-10-10T00:00:00Z&order=asc&limit=100",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "devices", "{{deviceId}}", "telemetry"],
          "query": [
            {
              "key": "from",
              "value": "2026-10-09T00:00:00Z"
            },
            {
              "key": "to",
              "value": "2026-10-10T00:00:00Z"
            },
            {
              "key": "order",
              "value": "asc"
            },
            {
              "key": "limit",
              "value": "100"
            }
          ]
        }
      },
