          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "devices", "{{deviceId}}", "telemetry"],
          "query": [
            {
              "key": "from",
              "value": "2026-10-09T00:00:00Z"
            },
            {
              "key": "to",
              "value": "2026-10-10T00:00:00Z"
            },
            {
              "key": "interval",
              "value": "1h"
            },
            {
              "key": "fields",
              "value": "rSOC_pct,rPackVoltage_V,rPackCurrent_A"
            }
          ]
        }
