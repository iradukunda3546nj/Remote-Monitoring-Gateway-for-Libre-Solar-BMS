# ---------------------------------------------------------------------------
# BEMRA backend configuration. Copy to .env and fill in secrets locally.
# Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL -------------------------------------------------------------
# Precedence: if DATABASE_URL is set it wins; the DB_* variables are ignored.
# DATABASE_URL=postgres://user:password@host:5432/bemra_db?sslmode=verify-full
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bemra_db
DB_USER=postgres
DB_PASSWORD=
# false | true (verify certificate, recommended for hosted DBs) | no-verify (NOT for production)
DB_SSL=false
# Optional path to a CA bundle for hosted PostgreSQL (PEM)
DB_SSL_CA_FILE=
DB_POOL_MAX=10

# --- MQTT -------------------------------------------------------------------
MQTT_HOST=test.mosquitto.org
MQTT_PORT=8886
MQTT_PROTOCOL=mqtts
MQTT_CLIENT_ID=bemra-backend-dev
# true on public test brokers (test.mosquitto.org loses persistent sessions)
MQTT_CLEAN_SESSION=false
MQTT_USERNAME=
MQTT_PASSWORD=
# Root topic. On the PUBLIC broker use a unique namespace, e.g. bemra-dev-<random>.
# This only reduces collisions; it is NOT security.
MQTT_TOPIC_ROOT=bemra
# Optional path to a CA bundle for a private broker (PEM). Empty = system CAs.
MQTT_CA_FILE=
# Keep-alive (s). Must be well below the shortest idle-connection timeout on the
# network path (NAT, firewall, broker front-end). 60 s was measured to be too long.
MQTT_KEEPALIVE_S=30

# --- HTTP API ---------------------------------------------------------------
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Required in production: comma-separated API keys accepted in the X-API-Key header
API_KEYS=

# --- Home Assistant MQTT discovery (published by the worker) ------------------
HA_DISCOVERY_ENABLED=true
# Default: <MQTT_TOPIC_ROOT>/homeassistant. Use plain "homeassistant" only on a private broker.
HA_DISCOVERY_PREFIX=

# Data older than this is STALE (seconds). Gateway publishes every 120 s.
STALE_AFTER_S=300
