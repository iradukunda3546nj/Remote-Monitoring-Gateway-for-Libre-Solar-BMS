{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bemra.dev/schemas/v1/telemetry.schema.json",
  "title": "BEMRA telemetry message (topics: live, replay)",
  "description": "One ThingSet Meas-group snapshot produced by the gateway. Values, names and units are exactly those of the Libre Solar BMS firmware. Bounds are corruption guards, not alarm limits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "gateway_id", "site_id", "boot_id", "sequence", "timestamps", "thingset"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "device_id": { "$ref": "common.schema.json#/$defs/deviceIdentifier" },
    "gateway_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "site_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "boot_id": { "$ref": "common.schema.json#/$defs/bootId" },
    "sequence": { "$ref": "common.schema.json#/$defs/sequence" },
    "timestamps": { "$ref": "common.schema.json#/$defs/timestamps" },
    "thingset": {
      "type": "object",
      "minProperties": 1,
      "required": ["rPackVoltage_V", "rSOC_pct", "rErrorFlags", "rBmsState", "rCellVoltages_V"],
      "properties": {
        "rPackVoltage_V": { "type": ["number", "null"], "minimum": 0, "maximum": 1000 },
        "rStackVoltage_V": { "type": ["number", "null"], "minimum": 0, "maximum": 1000 },
        "rPackCurrent_A": { "type": ["number", "null"], "minimum": -10000, "maximum": 10000 },
        "rCellTemps_degC": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": { "type": ["number", "null"], "minimum": -60, "maximum": 200 }
        },
        "rICTemp_degC": { "type": ["number", "null"], "minimum": -60, "maximum": 200 },
        "rMOSFETTemp_degC": { "type": ["number", "null"], "minimum": -60, "maximum": 200 },
        "rShuntTemp_degC": { "type": ["number", "null"], "minimum": -60, "maximum": 200 },
        "rSOC_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "rErrorFlags": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "rBmsState": { "type": "integer", "minimum": 0, "maximum": 255 },
        "rCellVoltages_V": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": ["number", "null"], "minimum": 0, "maximum": 10 }
        },
        "rCellAvgVoltage_V": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "rCellMinVoltage_V": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "rCellMaxVoltage_V": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "rBalancingStatus": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "propertyNames": { "$ref": "common.schema.json#/$defs/thingsetMeasName" },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/thingsetGenericValue" }
    }
  }
}
