{
  "name": "bemra-backend",
  "version": "0.1.0",
  "description": "BEMRA backend: MQTT ingestion worker, PostgreSQL persistence and REST API for Libre Solar BMS telemetry",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start:api": "node src/server.js",
    "start:worker": "node src/mqtt/worker.js",
    "dev:api": "node --watch src/server.js",
    "dev:worker": "node --watch src/mqtt/worker.js",
    "db:check": "node scripts/db-check.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:status": "node scripts/migrate.js status",
    "db:seed": "node scripts/seed-dev.js",
    "db:reset-test-data": "node scripts/reset-test-data.js",
    "db:retention": "node scripts/retention.js",
    "mqtt:publish-sample": "node scripts/publish-sample.js",
    "mqtt:check": "node scripts/mqtt-check.js",
    "ha:discovery": "node scripts/ha-discovery.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mqtt": "^5.16.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  }
}
