# Base URL of the BEMRA backend REST API (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Live polling interval in milliseconds (incremental fetches; keep >= 2000)
VITE_LIVE_POLL_MS=5000
# Diagnostic threshold for cell voltage spread (mV). A BEMRA display setting,
# not a BMS protection limit; protection limits come from the BMS Conf snapshot.
VITE_CELL_SPREAD_WARN_MV=50
# Shown as LIVE while the newest measurement is younger than this (s). Gateway publishes every 120 s.
VITE_FRESH_WITHIN_S=150
# Optional: sent as X-API-Key when the backend has API_KEYS set (always in production).
# WARNING: Vite compiles this into the public JavaScript bundle; anyone who can open the
# dashboard can read it. Use a read-only key and protect the dashboard itself.
VITE_API_KEY=
